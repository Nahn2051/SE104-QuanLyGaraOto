<UserControl x:Class="QuanLyGaraOto.Views.PhieuThuTienView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <UserControl.Resources>
        <!-- Colors -->
        <Color x:Key="PrimaryColor">#1565C0</Color>
        <Color x:Key="PrimaryDarkColor">#0D47A1</Color>
        <Color x:Key="SuccessColor">#2E7D32</Color>
        <Color x:Key="DangerColor">#C62828</Color>
        <Color x:Key="SurfaceColor">#FFFFFF</Color>
        <Color x:Key="BackgroundColor">#F5F7FA</Color>
        <Color x:Key="TextPrimaryColor">#212121</Color>
        <Color x:Key="TextSecondaryColor">#757575</Color>
        <Color x:Key="BorderColor">#E0E0E0</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

        <!-- Form Label -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Readonly Value -->
        <Style x:Key="ReadonlyValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Form TextBox -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Form ComboBox -->
        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,16" />
        </Style>
    </UserControl.Resources>

    <!-- MAIN LAYOUT -->
    <Border Background="{StaticResource BackgroundBrush}">
        <Grid>
            <!-- Card Container (Centered) -->
            <Border Background="{StaticResource SurfaceBrush}" 
                    CornerRadius="16" 
                    Width="600"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="40">
                <Border.Effect>
                    <DropShadowEffect Color="#000" BlurRadius="20" ShadowDepth="4" Opacity="0.08" Direction="270" />
                </Border.Effect>

                <StackPanel>
                    <!-- Header -->
                    <TextBlock Text="💰 LẬP PHIẾU THU TIỀN" 
                               FontSize="22" FontWeight="Bold" 
                               Foreground="{StaticResource PrimaryBrush}" 
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                    
                    <TextBlock Text="Thanh toán công nợ cho các xe đã sửa chữa" 
                               FontSize="13.5" Foreground="{StaticResource TextSecondaryBrush}" 
                               HorizontalAlignment="Center" Margin="0,0,0,32" />

                    <!-- Two-column Layout -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- LEFT COLUMN: Thông tin xe -->
                        <StackPanel Grid.Column="0">
                            <!-- Chọn Xe -->
                            <TextBlock Text="Biển số xe nợ" Style="{StaticResource FormLabel}" />
                            <ComboBox Style="{StaticResource FormComboBox}"
                                      ItemsSource="{Binding DanhSachXeNo}"
                                      SelectedItem="{Binding SelectedXe}"
                                      DisplayMemberPath="BienSo" />

                            <!-- Tên chủ xe -->
                            <TextBlock Text="Tên chủ xe" Style="{StaticResource FormLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Style="{StaticResource ReadonlyValue}" Text="{Binding SelectedXe.TenChuXe, TargetNullValue='---'}" />

                            <!-- Số điện thoại -->
                            <TextBlock Text="Điện thoại" Style="{StaticResource FormLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Style="{StaticResource ReadonlyValue}" Text="{Binding SelectedXe.DienThoai, TargetNullValue='---'}" />

                            <!-- Email -->
                            <TextBlock Text="Email" Style="{StaticResource FormLabel}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Style="{StaticResource ReadonlyValue}" Text="{Binding SelectedXe.Email, TargetNullValue='---'}" />
                        </StackPanel>

                        <!-- RIGHT COLUMN: Thanh toán -->
                        <StackPanel Grid.Column="2">
                            <!-- Số nợ hiện tại -->
                            <TextBlock Text="Số nợ hiện tại (VNĐ)" Style="{StaticResource FormLabel}" Foreground="{StaticResource DangerBrush}" />
                            <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,0,0,24"
                                       Text="{Binding SelectedXe.TienNo, StringFormat=N0, TargetNullValue='0'}" />

                            <!-- Ngày thu tiền -->
                            <TextBlock Text="Ngày thu tiền" Style="{StaticResource FormLabel}" />
                            <DatePicker Height="40" FontSize="14" Padding="8,8" Margin="0,0,0,16"
                                        SelectedDate="{Binding NgayThuTien}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5">
                                <DatePicker.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8" />
                                    </Style>
                                </DatePicker.Resources>
                            </DatePicker>

                            <!-- Số tiền thu -->
                            <TextBlock Style="{StaticResource FormLabel}">
                                <Run Text="Số tiền khách trả" />
                                <Run Text=" *" Foreground="{StaticResource DangerBrush}" />
                            </TextBlock>
                            <TextBox Style="{StaticResource FormTextBox}" 
                                     Text="{Binding SoTienThu, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" />
                            
                        </StackPanel>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16,0,24" />

                    <!-- Submit Button -->
                    <Button Content="✅ Xác Nhận Thu Tiền" 
                            Command="{Binding LuuPhieuThuCommand}"
                            Height="48" FontSize="15" FontWeight="Bold" Foreground="White" Cursor="Hand" BorderThickness="0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource SuccessColor}" Offset="0" />
                                <GradientStop Color="#43A047" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="{StaticResource SuccessColor}" />
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.4" Color="{StaticResource SuccessColor}" />
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                            </Setter.Value>
                                        </Setter>
                                        <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Background" Value="#BDBDBD" />
                                        <Setter TargetName="border" Property="Effect" Value="{x:Null}" />
                                        <Setter Property="Foreground" Value="#9E9E9E" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
