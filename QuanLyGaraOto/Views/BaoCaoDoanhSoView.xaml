<UserControl x:Class="QuanLyGaraOto.Views.BaoCaoDoanhSoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:behaviors="clr-namespace:QuanLyGaraOto.Behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Colors & Brushes -->
        <Color x:Key="PrimaryColor">#1565C0</Color>
        <Color x:Key="SuccessColor">#2E7D32</Color>
        <Color x:Key="SurfaceColor">#FFFFFF</Color>
        <Color x:Key="BackgroundColor">#F5F7FA</Color>
        <Color x:Key="TextPrimaryColor">#212121</Color>
        <Color x:Key="TextSecondaryColor">#757575</Color>
        <Color x:Key="BorderColor">#E0E0E0</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="FormInput" TargetType="Control">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="12,0" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border Background="{StaticResource BackgroundBrush}" Padding="20">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- HEADER KHUNG ĐIỀU KIỆN LỌC -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="24">
                <Border.Effect>
                    <DropShadowEffect Color="#000" BlurRadius="12" ShadowDepth="1" Opacity="0.05" Direction="270" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,24,16">
                        <TextBlock Text="📊 BÁO CÁO DOANH SỐ THÁNG" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16" />
                        
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                <TextBlock Text="Tháng:" Style="{StaticResource FormLabel}" />
                                <ComboBox ItemsSource="{Binding DanhSachThang}" 
                                          SelectedItem="{Binding Thang}" 
                                          Width="100" Style="{StaticResource FormInput}" VerticalContentAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                <TextBlock Text="Năm:" Style="{StaticResource FormLabel}" />
                                <TextBox Text="{Binding Nam, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="100" Style="{StaticResource FormInput}" 
                                         VerticalContentAlignment="Center" />
                            </StackPanel>

                            <Button Content="📋 Lập Báo Cáo" Command="{Binding LapBaoCaoCommand}" 
                                    Height="40" Padding="24,0" FontSize="14" FontWeight="Bold" 
                                    Foreground="White" Background="{StaticResource SuccessBrush}" 
                                    BorderThickness="0" Cursor="Hand" Margin="0,0,0,8">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="border" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <!-- Khối TỔNG DOANH THU nổi bật -->
                    <Border Grid.Column="1" Background="#E3F2FD" CornerRadius="8" Padding="24,12" BorderBrush="#BBDEFB" BorderThickness="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Doanh thu sửa chữa:" FontSize="13" Foreground="#1565C0" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{Binding TongDoanhThu, StringFormat=N0}" FontSize="14" FontWeight="Bold" Foreground="#0D47A1" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Doanh thu khác (Tiền phạt/dư):" FontSize="13" Foreground="#1565C0" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{Binding DoanhThuKhac, StringFormat=N0}" FontSize="14" FontWeight="Bold" Foreground="#0D47A1" HorizontalAlignment="Right" />
                            </Grid>
                            <Separator Background="#90CAF9" Margin="0,4,0,8" />
                            <TextBlock Text="Tổng Doanh Thu Thực Tế (VNĐ)" FontSize="13" FontWeight="SemiBold" Foreground="#1565C0" HorizontalAlignment="Right" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding TongDoanhThuThucTe, StringFormat=N0}" FontSize="28" FontWeight="Bold" Foreground="#0D47A1" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- DATAGRID CHI TIẾT BÁO CÁO -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#000" BlurRadius="12" ShadowDepth="1" Opacity="0.05" Direction="270" />
                </Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Chi tiết doanh số theo Hiệu xe (Nháy đúp để xem các xe đã sửa)" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <Button Content="📥 Xuất Excel" Command="{Binding XuatExcelCommand}" HorizontalAlignment="Right"
                                Padding="12,6" Background="#2E7D32" Foreground="White" FontWeight="Bold" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <DataGrid ItemsSource="{Binding ChiTietBaoCao}"
                              SelectedItem="{Binding SelectedRow}"
                              behaviors:DataGridBehavior.AutoNumber="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEFF1"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                              RowHeight="44" ColumnHeaderHeight="44"
                              Background="White" RowBackground="White" AlternatingRowBackground="#FAFBFC">
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding XemChiTietCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F5F7FA" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,0" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="STT" Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}" Width="60" />
                            <DataGridTextColumn Header="Hiệu Xe" Binding="{Binding TenHieuXe}" Width="*" FontWeight="SemiBold" />
                            
                            <DataGridTextColumn Header="Số Lượt Sửa" Binding="{Binding SoLuotSua, StringFormat=N0}" Width="150" />
                            
                            <DataGridTextColumn Header="Thành Tiền (VNĐ)" Binding="{Binding ThanhTien, StringFormat=N0}" Width="*" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                            
                            <!-- Tỉ lệ % -->
                            <DataGridTextColumn Header="Tỉ Lệ %" Binding="{Binding TiLe, StringFormat=N2}" Width="150" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
        </Border>
    <!-- DIALOG XEM CHI TIẾT (Drill-down) -->
    <Grid Visibility="{Binding IsPopupOpen, Converter={StaticResource BoolToVis}}" Background="#80000000" Panel.ZIndex="100">
        <Border Background="White" CornerRadius="16" Width="800" Height="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="30" Opacity="0.3" ShadowDepth="5" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Chi Tiết Các Xe Đã Sửa" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Hiệu xe: " FontSize="14" Foreground="#757575" />
                        <TextBlock Text="{Binding SelectedRow.TenHieuXe}" FontSize="14" FontWeight="Bold" Foreground="#424242" />
                        <TextBlock Text=" | Tháng: " FontSize="14" Foreground="#757575" />
                        <TextBlock Text="{Binding Thang}" FontSize="14" FontWeight="Bold" Foreground="#424242" />
                        <TextBlock Text="/" FontSize="14" FontWeight="Bold" Foreground="#424242" />
                        <TextBlock Text="{Binding Nam}" FontSize="14" FontWeight="Bold" Foreground="#424242" />
                    </StackPanel>
                </StackPanel>

                <DataGrid Grid.Row="2" ItemsSource="{Binding DanhSachPhieuChiTiet}"
                          behaviors:DataGridBehavior.AutoNumber="True"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEFF1"
                          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                          RowHeight="42" ColumnHeaderHeight="42"
                          Background="White" RowBackground="White" AlternatingRowBackground="#FAFBFC">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F5F7FA" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="10,0" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="STT" Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}" Width="50" />
                        <DataGridTextColumn Header="Mã Phiếu" Binding="{Binding MaPhieuSuaChua}" Width="100" FontWeight="Bold" />
                        <DataGridTextColumn Header="Biển Số Xe" Binding="{Binding Xe.BienSo}" Width="150" FontWeight="Bold" />
                        <DataGridTextColumn Header="Ngày Sửa Chữa" Binding="{Binding NgaySuaChua, StringFormat=dd/MM/yyyy HH:mm}" Width="*" />
                        <DataGridTextColumn Header="Tổng Tiền" Binding="{Binding TongTien, StringFormat=N0}" Width="150" FontWeight="Bold" Foreground="#2E7D32"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="📥 Xuất Excel" Command="{Binding XuatExcelChiTietCommand}" 
                            Padding="20,8" Background="#2E7D32" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="0,0,12,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="Đóng" Command="{Binding DongChiTietCommand}" 
                            Padding="20,8" Background="#9E9E9E" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </Grid>
</UserControl>
