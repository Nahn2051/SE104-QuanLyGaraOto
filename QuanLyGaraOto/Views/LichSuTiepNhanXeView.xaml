<UserControl x:Class="QuanLyGaraOto.Views.LichSuTiepNhanXeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:QuanLyGaraOto.Converters"
             xmlns:behaviors="clr-namespace:QuanLyGaraOto.Behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <Color x:Key="PrimaryColor">#1565C0</Color>
        <Color x:Key="SurfaceColor">#FFFFFF</Color>
        <Color x:Key="BackgroundColor">#F5F7FA</Color>
        <Color x:Key="TextPrimaryColor">#212121</Color>
        <Color x:Key="TextSecondaryColor">#757575</Color>
        <Color x:Key="BorderColor">#E0E0E0</Color>

        <!-- Converters -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BienSoConverter x:Key="BienSoConverter" />
        <converters:RowToIndexConverter x:Key="RowToIndexConverter" />

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundBrush}" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- KHUNG TÌM KIẾM -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#000" BlurRadius="10" ShadowDepth="1" Opacity="0.05" Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🕒 LỊCH SỬ TIẾP NHẬN XE" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16" />
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="Từ ngày:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DatePicker SelectedDate="{Binding TuNgay, UpdateSourceTrigger=PropertyChanged}" Width="130" Height="40" Padding="8,0" VerticalContentAlignment="Center" />
                        </StackPanel>
                
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0">
                            <TextBlock Text="Đến ngày:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <DatePicker SelectedDate="{Binding DenNgay, UpdateSourceTrigger=PropertyChanged}" Width="130" Height="40" Padding="8,0" VerticalContentAlignment="Center" />
                            <Button Content="✕" Command="{Binding BoLocNgayCommand}" ToolTip="Bỏ lọc ngày" 
                                    Background="Transparent" BorderThickness="0" Foreground="#D32F2F" FontSize="16" FontWeight="Bold" 
                                    VerticalAlignment="Center" Margin="8,0,0,0" Cursor="Hand" />
                        </StackPanel>

                        <!-- Ô nhập tìm kiếm, cập nhật ngay khi gõ bằng UpdateSourceTrigger=PropertyChanged -->
                        <TextBox Grid.Column="2" Text="{Binding TuKhoa, UpdateSourceTrigger=PropertyChanged}" 
                                 Height="44" Padding="12,0" FontSize="15" 
                                 VerticalContentAlignment="Center"
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5"
                                 ToolTip="Nhập Biển số, Tên chủ xe hoặc Hiệu xe" />
                        
                        <Button Grid.Column="3" Content="Tìm kiếm" Command="{Binding TimKiemCommand}" 
                                Height="44" Padding="24,0" FontSize="15" FontWeight="Bold" 
                                Foreground="White" Background="{StaticResource PrimaryBrush}" BorderThickness="0" Cursor="Hand" Margin="16,0,0,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Opacity" Value="0.9" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="border" Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <TextBlock Text="Mẹo: Hệ thống tự động tìm theo biển số, tên chủ xe và hiệu xe. Gõ chữ thường/hoa đều được." 
                               FontSize="12" Foreground="#9E9E9E" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- DANH SÁCH KẾT QUẢ -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#000" BlurRadius="10" ShadowDepth="1" Opacity="0.05" Direction="270" />
                </Border.Effect>
                
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Kết quả tra cứu (Nháy đúp vào một dòng để xem chi tiết)" FontSize="15" FontWeight="SemiBold" Foreground="#757575" VerticalAlignment="Center" />
                        <Button Content="📥 Xuất Excel" Command="{Binding XuatExcelCommand}" HorizontalAlignment="Right"
                                Padding="12,6" Background="#2E7D32" Foreground="White" FontWeight="Bold" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <DataGrid ItemsSource="{Binding DanhSachXe}"
                              SelectedItem="{Binding SelectedXe, Mode=TwoWay}"
                              behaviors:DataGridBehavior.AutoNumber="True"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEFF1"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                              RowHeight="42" ColumnHeaderHeight="42"
                              Background="White" RowBackground="White" AlternatingRowBackground="#FAFBFC">
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding XemChiTietCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F5F7FA" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,0" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD" />
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <!-- Cột STT liên kết tới Row.Header siêu chuẩn và chống lỗi -->
                            <DataGridTextColumn Header="STT" 
                                                Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Header}" 
                                                Width="50" />

                            <!-- Cột Biển số dùng BienSoConverter -->
                            <DataGridTextColumn Header="Biển số" 
                                                Binding="{Binding BienSo, Converter={StaticResource BienSoConverter}}" 
                                                Width="0.8*" FontWeight="Bold" />
                            
                            <!-- Bind theo Navigation Property HieuXe.TenHieuXe -->
                            <DataGridTextColumn Header="Hiệu xe" Binding="{Binding HieuXe.TenHieuXe}" Width="0.8*" />
                            
                            <DataGridTextColumn Header="Tên chủ xe" Binding="{Binding TenChuXe}" Width="1.2*" />
                            
                            <DataGridTextColumn Header="Điện thoại" Binding="{Binding DienThoai}" Width="0.8*" />
                            
                            <DataGridTextColumn Header="Địa chỉ" Binding="{Binding DiaChi}" Width="1.5*" />
                            
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="1.2*" />
                            
                            <DataGridTextColumn Header="Ngày tiếp nhận" Binding="{Binding NgayTiepNhan, StringFormat=dd/MM/yyyy}" Width="1*" />
                            
                            <!-- Cột Tiền nợ được Format tiền tệ đẹp -->
                            <DataGridTextColumn Header="Tiền nợ" Binding="{Binding TienNo, StringFormat=N0}" Width="0.8*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
            <!-- POPUP CHI TIẾT XE -->
            <Border Grid.Row="0" Grid.RowSpan="3" Background="#80000000" Visibility="{Binding IsPopupOpen, Converter={StaticResource BoolToVis}}">
                <Border Background="White" CornerRadius="12" Width="700" MaxHeight="650" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#000" BlurRadius="20" ShadowDepth="4" Opacity="0.2" Direction="270" />
                    </Border.Effect>
                    <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Tiêu đề và nút đóng -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <TextBlock Text="THÔNG TIN CHI TIẾT XE" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                            <Button Content="✕" Command="{Binding DongChiTietCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" FontSize="16" Foreground="#757575" Cursor="Hand" />
                        </Grid>

                        <!-- Thông tin xe -->
                        <Border Grid.Row="1" Background="#F8F9FA" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Col 1 -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Biển số:" FontWeight="SemiBold" Margin="0,4,8,4" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedXe.BienSo, Converter={StaticResource BienSoConverter}}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,4,16,4" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Hiệu xe:" FontWeight="SemiBold" Margin="0,4,8,4" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedXe.HieuXe.TenHieuXe}" Margin="0,4,16,4" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Chủ xe:" FontWeight="SemiBold" Margin="0,4,8,4" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedXe.TenChuXe}" Margin="0,4,16,4" />
                                
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Điện thoại:" FontWeight="SemiBold" Margin="0,4,8,4" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedXe.DienThoai}" Margin="0,4,16,4" />

                                <!-- Col 2 -->
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Email:" FontWeight="SemiBold" Margin="0,4,8,4" />
                                <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding SelectedXe.Email}" Margin="0,4,0,4" />

                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Địa chỉ:" FontWeight="SemiBold" Margin="0,4,8,4" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding SelectedXe.DiaChi}" TextWrapping="Wrap" Margin="0,4,0,4" />

                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Tiếp nhận:" FontWeight="SemiBold" Margin="0,4,8,4" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding SelectedXe.NgayTiepNhan, StringFormat=dd/MM/yyyy HH:mm}" Margin="0,4,0,4" />

                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Tiền nợ:" FontWeight="SemiBold" Margin="0,4,8,4" />
                                <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding SelectedXe.TienNo, StringFormat=N0}" FontWeight="Bold" Foreground="#D32F2F" Margin="0,4,0,4" />
                            </Grid>
                        </Border>

                        <!-- Lịch sử sửa chữa -->
                        <DockPanel Grid.Row="2" Margin="0,0,0,16">
                            <TextBlock DockPanel.Dock="Top" Text="Lịch sử sửa chữa" FontSize="14" FontWeight="SemiBold" Foreground="#757575" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding LichSuSuaChua}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEFF1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" RowHeight="36" ColumnHeaderHeight="36" Background="White">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F5F7FA" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Padding" Value="10,0" />
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mã Phiếu" Binding="{Binding MaPhieuSuaChua}" Width="80" />
                                    <DataGridTextColumn Header="Ngày sửa chữa" Binding="{Binding NgaySuaChua, StringFormat=dd/MM/yyyy HH:mm}" Width="*" />
                                    <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TongTien, StringFormat=N0}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <!-- Nút hành động -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🗑️ Xóa Xe" Command="{Binding HuyXeCommand}" Padding="16,8" Margin="0,0,12,0" Background="#D32F2F" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="📥 Xuất Báo Cáo Excel" Command="{Binding XuatExcelChiTietCommand}" Padding="16,8" Margin="0,0,12,0" Background="#2E7D32" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="Đóng" Command="{Binding DongChiTietCommand}" Padding="20,8" Background="#E0E0E0" Foreground="#424242" FontWeight="Bold" BorderThickness="0" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Border>
</UserControl>
