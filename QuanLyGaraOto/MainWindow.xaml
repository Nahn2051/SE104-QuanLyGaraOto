<Window x:Class="QuanLyGaraOto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:QuanLyGaraOto.Views"
        xmlns:viewmodels="clr-namespace:QuanLyGaraOto.ViewModels"
        mc:Ignorable="d"
        Title="Quản Lý Gara Oto" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Converter: bool → Visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- DataTemplates cho Navigation -->
        <DataTemplate DataType="{x:Type viewmodels:TiepNhanXeViewModel}">
            <views:TiepNhanXeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:QuanLyHieuXeViewModel}">
            <views:QuanLyHieuXeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:QuanLyTienCongViewModel}">
            <views:QuanLyTienCongView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:PhieuSuaChuaViewModel}">
            <views:PhieuSuaChuaView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:TraCuuXeViewModel}">
            <views:TraCuuXeView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:TraCuuPhieuSuaChuaViewModel}">
            <views:TraCuuPhieuSuaChuaView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:TraCuuPhieuNhapKhoViewModel}">
            <views:TraCuuPhieuNhapKhoView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:BaoCaoDoanhSoViewModel}">
            <views:BaoCaoDoanhSoView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:BaoCaoTonKhoViewModel}">
            <views:BaoCaoTonKhoView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:PhieuThuTienViewModel}">
            <views:PhieuThuTienView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:QuanLyVatTuViewModel}">
            <views:QuanLyVatTuView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:PhieuNhapKhoViewModel}">
            <views:PhieuNhapKhoView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:ThayDoiQuyDinhViewModel}">
            <views:ThayDoiQuyDinhView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:QuanLyNguoiDungViewModel}">
            <views:QuanLyNguoiDungView />
        </DataTemplate>

        <!-- ============================================================= -->
        <!-- SIDEBAR MENU BUTTON STYLE                                      -->
        <!-- ============================================================= -->
        <Style x:Key="MenuButton" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#B0BEC5" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#37474F" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#455A64" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================= -->
        <!-- SIDEBAR SECTION HEADER                                         -->
        <!-- ============================================================= -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#546E7A" />
            <Setter Property="Margin" Value="20,18,0,8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="250" />
            <!-- Main content -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================= -->
        <!-- SIDEBAR                                                        -->
        <!-- ============================================================= -->
        <Border Grid.Column="0" Background="#263238">
            <DockPanel>
                <!-- ───── User info (bottom) ───── -->
                <Border DockPanel.Dock="Bottom" Padding="16,12"
                        Background="#1C272B">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Border Grid.Column="0" Width="36" Height="36"
                                CornerRadius="18" Margin="0,0,10,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#667eea" Offset="0" />
                                    <GradientStop Color="#764ba2" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="👤" FontSize="16"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>

                        <!-- Tên + Vai trò -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TenNguoiDung}"
                                       Foreground="White" FontSize="13" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding TenVaiTro}"
                                       Foreground="#78909C" FontSize="11" />
                        </StackPanel>

                        <!-- Nút Đăng xuất -->
                        <Button Grid.Column="2" Content="⏻" FontSize="16"
                                Foreground="#78909C" Background="Transparent"
                                BorderThickness="0" Cursor="Hand"
                                ToolTip="Đăng xuất" Width="32" Height="32"
                                Command="{Binding DangXuatCommand}" />
                    </Grid>
                </Border>

                <!-- ───── Menu items ───── -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Logo -->
                        <StackPanel Margin="20,20,20,10">
                            <TextBlock Text="🚗 GARA ÔTÔ"
                                       Foreground="White" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="Hệ thống quản lý"
                                       Foreground="#546E7A" FontSize="11" Margin="0,2,0,0" />
                        </StackPanel>

                        <Border Height="1" Background="#37474F" Margin="16,8" />

                        <!-- ───── NGHIỆP VỤ ───── -->
                        <TextBlock Text="NGHIỆP VỤ" Style="{StaticResource SectionHeader}" />

                        <Button Content="🏷️  Quản lý hiệu xe"
                                Style="{StaticResource MenuButton}"
                                Command="{Binding ShowQuanLyHieuXeCommand}" />

                        <Button Content="🛠️  Quản lý tiền công"
                                Style="{StaticResource MenuButton}"
                                Command="{Binding ShowQuanLyTienCongCommand}" />

                        <Button Content="📋  Tiếp nhận xe"
                                Style="{StaticResource MenuButton}"
                                Command="{Binding ShowTiepNhanXeCommand}" />

                        <Button Content="🔧  Lập phiếu sửa chữa"
                                Style="{StaticResource MenuButton}"
                                Command="{Binding ShowPhieuSuaChuaCommand}" />

                        <Button Content="💰  Lập phiếu thu tiền"
                                Style="{StaticResource MenuButton}"
                                Command="{Binding ShowPhieuThuTienCommand}" />

                        <Button Content="📦  Quản lý vật tư phụ tùng"
                                Style="{StaticResource MenuButton}"
                                Command="{Binding ShowQuanLyVatTuCommand}" />

                        <Button Content="📥  Nhập kho vật tư"
                                Style="{StaticResource MenuButton}"
                                Command="{Binding ShowPhieuNhapKhoCommand}" />

                        <Button Content="🔍  Tra cứu xe"
                                Style="{StaticResource MenuButton}"
                                Command="{Binding ShowTraCuuXeCommand}" />

                        <!-- ───── TRA CỨU ───── -->
                        <TextBlock Text="TRA CỨU LỊCH SỬ" Style="{StaticResource SectionHeader}" />

                        <Button Content="📄  Lịch sử sửa chữa"
                                Style="{StaticResource MenuButton}"
                                Command="{Binding ShowTraCuuPhieuSuaChuaCommand}" />

                        <Button Content="📥  Lịch sử nhập kho"
                                Style="{StaticResource MenuButton}"
                                Command="{Binding ShowTraCuuPhieuNhapKhoCommand}" />

                        <!-- ───── BÁO CÁO ───── -->
                        <TextBlock Text="BÁO CÁO" Style="{StaticResource SectionHeader}" />

                        <Button Content="📊  Báo cáo doanh thu"
                                Style="{StaticResource MenuButton}"
                                Command="{Binding ShowBaoCaoDoanhSoCommand}" />

                        <Button Content="📈  Báo cáo tồn kho"
                                Style="{StaticResource MenuButton}"
                                Command="{Binding ShowBaoCaoTonKhoCommand}" />

                        <!-- ───── HỆ THỐNG (CHỈ QUẢN LÝ) ───── -->
                        <!--
                            ★ PHÂN QUYỀN TẠI ĐÂY ★
                            Binding IsAdmin (bool) qua BooleanToVisibilityConverter:
                              - IsAdmin = true  → Visible   (Quản lý thấy)
                              - IsAdmin = false → Collapsed  (Nhân viên KHÔNG thấy)
                        -->
                        <TextBlock Text="HỆ THỐNG" Style="{StaticResource SectionHeader}"
                                   Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />

                        <Button Content="⚙️  Thay đổi quy định"
                                Style="{StaticResource MenuButton}"
                                Command="{Binding ShowThayDoiQuyDinhCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />

                        <Button Content="👥  Quản lý người dùng"
                                Style="{StaticResource MenuButton}"
                                Command="{Binding ShowQuanLyNguoiDungCommand}"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============================================================= -->
        <!-- MAIN CONTENT AREA                                              -->
        <!-- ============================================================= -->
        <Border Grid.Column="1" Background="#F5F7FA">
            <!-- Hiển thị View động dựa trên ViewModel hiện tại -->
            <ContentControl Content="{Binding CurrentView}" />
        </Border>

    </Grid>
</Window>
