<UserControl x:Class="QuanLyGaraOto.Views.PhieuSuaChuaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="850">

    <UserControl.Resources>
        <!-- ============================================================= -->
        <!-- COLORS                                                         -->
        <!-- ============================================================= -->
        <Color x:Key="PrimaryColor">#1565C0</Color>
        <Color x:Key="PrimaryDarkColor">#0D47A1</Color>
        <Color x:Key="AccentColor">#26A69A</Color>
        <Color x:Key="SuccessColor">#2E7D32</Color>
        <Color x:Key="DangerColor">#C62828</Color>
        <Color x:Key="SurfaceColor">#FFFFFF</Color>
        <Color x:Key="BackgroundColor">#F5F7FA</Color>
        <Color x:Key="TextPrimaryColor">#212121</Color>
        <Color x:Key="TextSecondaryColor">#757575</Color>
        <Color x:Key="BorderColor">#E0E0E0</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

        <!-- ============================================================= -->
        <!-- FORM LABEL                                                     -->
        <!-- ============================================================= -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- ============================================================= -->
        <!-- FORM TEXTBOX                                                   -->
        <!-- ============================================================= -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush"
                                        Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="border" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================= -->
        <!-- FORM COMBOBOX                                                  -->
        <!-- ============================================================= -->
        <Style x:Key="FormComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- ============================================================= -->
        <!-- ACTION BUTTON (Primary / Success / Danger)                     -->
        <!-- ============================================================= -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1"
                                                  Opacity="0.2" Direction="270" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="3"
                                                          Opacity="0.3" Direction="270" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransformOrigin"
                                        Value="0.5,0.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#BDBDBD" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="Effect" Value="{x:Null}" />
                                <Setter Property="Foreground" Value="#9E9E9E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============================================================= -->
        <!-- MONEY DISPLAY                                                  -->
        <!-- ============================================================= -->
        <Style x:Key="MoneyLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- ================================================================= -->
    <!-- MAIN LAYOUT                                                        -->
    <!-- ================================================================= -->
    <Border Background="{StaticResource BackgroundBrush}" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Header -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Thông tin chung -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: DataGrid chi tiết -->
                <RowDefinition Height="*" />
                <!-- Row 3: Tổng tiền + Buttons -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ========================================================= -->
            <!-- HEADER                                                     -->
            <!-- ========================================================= -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="12" Padding="20,16" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect Color="#000" BlurRadius="12"
                                      ShadowDepth="1" Opacity="0.06" Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🔧  Lập Phiếu Sửa Chữa"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" />
                    <TextBlock Text="Tạo phiếu sửa chữa mới và quản lý chi tiết vật tư, tiền công"
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- ========================================================= -->
            <!-- PHẦN TRÊN: Thông tin chung                                 -->
            <!-- ========================================================= -->
            <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="12" Padding="20,18" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect Color="#000" BlurRadius="12"
                                      ShadowDepth="1" Opacity="0.06" Direction="270" />
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Biển số xe -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FormLabel}">
                            <Run Text="Biển số xe" />
                            <Run Text=" *" Foreground="#E53935" FontWeight="Bold" />
                        </TextBlock>
                        <ComboBox Style="{StaticResource FormComboBox}"
                                  ItemsSource="{Binding DanhSachXe}"
                                  SelectedItem="{Binding SelectedXe}"
                                  DisplayMemberPath="BienSo" />
                    </StackPanel>

                    <!-- Ngày sửa chữa -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Ngày sửa chữa" Style="{StaticResource FormLabel}" />
                        <DatePicker Height="38" FontSize="13.5" Padding="8,6"
                                    SelectedDate="{Binding NgaySuaChua}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1.5">
                            <DatePicker.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8" />
                                </Style>
                            </DatePicker.Resources>
                        </DatePicker>
                    </StackPanel>

                    <!-- Số tiền trả -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Số tiền trả (VNĐ)" Style="{StaticResource FormLabel}" />
                        <TextBox Style="{StaticResource FormTextBox}"
                                 Text="{Binding SoTienTra, UpdateSourceTrigger=PropertyChanged,
                                        StringFormat=N0}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- PHẦN DƯỚI: DataGrid chi tiết sửa chữa                     -->
            <!-- ========================================================= -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="12" Padding="16,14" Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect Color="#000" BlurRadius="12"
                                      ShadowDepth="1" Opacity="0.06" Direction="270" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Toolbar: Thêm / Xóa dòng -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Chi tiết sửa chữa"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="＋ Thêm dòng"
                                    Style="{StaticResource ActionButton}"
                                    Background="{StaticResource AccentBrush}"
                                    Command="{Binding ThemChiTietCommand}"
                                    Margin="0,0,8,0" />

                            <Button Content="✕ Xóa dòng"
                                    Style="{StaticResource ActionButton}"
                                    Background="{StaticResource DangerBrush}"
                                    Command="{Binding XoaChiTietCommand}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ChiTietSuaChuas}"
                              SelectedItem="{Binding SelectedChiTiet}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserSortColumns="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#ECEFF1"
                              BorderBrush="{StaticResource BorderBrush}"
                              BorderThickness="1"
                              RowHeight="38"
                              ColumnHeaderHeight="40"
                              FontSize="13"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#FAFBFC">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F5F7FA" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="FontSize" Value="12.5" />
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="BorderBrush" Value="#E0E0E0" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6,0" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E3F2FD" />
                                        <Setter Property="Foreground"
                                                Value="{StaticResource TextPrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <!-- Nội dung sửa chữa -->
                            <DataGridTextColumn Header="Nội dung sửa chữa" Width="*"
                                                Binding="{Binding NoiDungSuaChua,
                                                          UpdateSourceTrigger=PropertyChanged}" />

                            <!-- Vật tư (ComboBox) -->
                            <DataGridTemplateColumn Header="Vật tư" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.DanhSachVatTu,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding SelectedVatTu,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="TenVTPT"
                                                  BorderThickness="0" Background="Transparent"
                                                  FontSize="13" Padding="4,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Tiền công (ComboBox) -->
                            <DataGridTemplateColumn Header="Tiền công" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.DanhSachTienCong,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding SelectedTienCong,
                                                      UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="TenTienCong"
                                                  BorderThickness="0" Background="Transparent"
                                                  FontSize="13" Padding="4,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Số lượng -->
                            <DataGridTextColumn Header="SL" Width="60"
                                                Binding="{Binding SoLuong,
                                                          UpdateSourceTrigger=PropertyChanged}" />

                            <!-- Đơn giá (read-only, tự hiện khi chọn vật tư) -->
                            <DataGridTextColumn Header="Đơn giá" Width="110" IsReadOnly="True"
                                                Binding="{Binding DonGia, StringFormat=N0}" />

                            <!-- Thành tiền (read-only, tự tính) -->
                            <DataGridTextColumn Header="Thành tiền" Width="120" IsReadOnly="True"
                                                Binding="{Binding ThanhTien, StringFormat=N0}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground"
                                                Value="{StaticResource PrimaryBrush}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ========================================================= -->
            <!-- PHẦN CUỐI: Tổng tiền + Nút Lưu                            -->
            <!-- ========================================================= -->
            <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="12" Padding="20,16">
                <Border.Effect>
                    <DropShadowEffect Color="#000" BlurRadius="12"
                                      ShadowDepth="1" Opacity="0.06" Direction="270" />
                </Border.Effect>

                <DockPanel>
                    <!-- Nút Lưu Phiếu (bên phải) -->
                    <Button DockPanel.Dock="Right"
                            Content="💾  Lưu Phiếu Sửa Chữa"
                            Style="{StaticResource ActionButton}"
                            MinWidth="200" Height="44" FontSize="15"
                            Command="{Binding LuuPhieuCommand}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="{StaticResource PrimaryColor}" Offset="0" />
                                <GradientStop Color="{StaticResource PrimaryDarkColor}" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <!-- Tổng tiền (bên trái) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Tổng tiền -->
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock Text="Tổng tiền" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Style="{StaticResource MoneyLabel}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding TongTien, StringFormat={}{0:N0} VNĐ}" />
                        </StackPanel>

                        <!-- Separator -->
                        <Border Width="1" Height="36" Background="#E0E0E0"
                                Margin="0,0,32,0" />

                        <!-- Số tiền trả -->
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock Text="Số tiền trả" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Style="{StaticResource MoneyLabel}"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="{Binding SoTienTra, StringFormat={}{0:N0} VNĐ}" />
                        </StackPanel>

                        <!-- Separator -->
                        <Border Width="1" Height="36" Background="#E0E0E0"
                                Margin="0,0,32,0" />

                        <!-- Tiền còn lại (nợ) -->
                        <StackPanel>
                            <TextBlock Text="Tiền còn lại" FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Style="{StaticResource MoneyLabel}"
                                       Foreground="{StaticResource DangerBrush}"
                                       Text="{Binding TienConLai, StringFormat={}{0:N0} VNĐ}" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
