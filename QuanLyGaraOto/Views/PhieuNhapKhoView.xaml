<UserControl x:Class="QuanLyGaraOto.Views.PhieuNhapKhoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:QuanLyGaraOto.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <!-- Colors & Brushes -->
        <Color x:Key="PrimaryColor">#1565C0</Color>
        <Color x:Key="SuccessColor">#2E7D32</Color>
        <Color x:Key="DangerColor">#C62828</Color>
        <Color x:Key="SurfaceColor">#FFFFFF</Color>
        <Color x:Key="BackgroundColor">#F5F7FA</Color>
        <Color x:Key="TextPrimaryColor">#212121</Color>
        <Color x:Key="BorderColor">#E0E0E0</Color>

        <converters:StringToNumberConverter x:Key="StringToNumberConverter" />

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

        <!-- Form Label -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <!-- Action Button -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#BDBDBD" />
                                <Setter Property="Foreground" Value="#9E9E9E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundBrush}" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- HEADER SECTION -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#000" BlurRadius="10" ShadowDepth="1" Opacity="0.05" Direction="270" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ngày Nhập Kho" Style="{StaticResource FormLabel}" />
                        <DatePicker SelectedDate="{Binding NgayNhap}" Width="200" Height="36" FontSize="14" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="Tổng Tiền Nhập (VNĐ)" Style="{StaticResource FormLabel}" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding TongTien, StringFormat=N0}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- BODY SECTION (DataGrid) -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#000" BlurRadius="10" ShadowDepth="1" Opacity="0.05" Direction="270" />
                </Border.Effect>
                <DockPanel>
                    <!-- Toolbar for DataGrid -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Danh Sách Vật Tư Nhập" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button Content="＋ Thêm Dòng" Command="{Binding ThemChiTietCommand}" Background="{StaticResource PrimaryBrush}" Style="{StaticResource ActionButton}" Height="32" Padding="12,0" />
                        <Button Content="✕ Xóa Dòng" Command="{Binding XoaChiTietCommand}" CommandParameter="{Binding SelectedItems, ElementName=dgChiTiet}" Background="{StaticResource DangerBrush}" Style="{StaticResource ActionButton}" Height="32" Padding="12,0" />
                    </StackPanel>

                    <!-- DataGrid Edit Trực Tiếp -->
                    <DataGrid x:Name="dgChiTiet" ItemsSource="{Binding ChiTietNhapKhos}"
                              SelectedItem="{Binding SelectedChiTiet}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#ECEFF1"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                              RowHeight="42" ColumnHeaderHeight="40"
                              Background="White" RowBackground="White" AlternatingRowBackground="#FAFBFC">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F5F7FA" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,0" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        
                        <DataGrid.Columns>
                            <!-- Cột ComboBox Chọn Vật Tư -->
                            <DataGridTemplateColumn Header="Tên Vật Tư / Phụ Tùng" Width="3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.DanhSachVatTu, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedItem="{Binding SelectedVatTu, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="TenVTPT"
                                                  Margin="4" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột Số Lượng (Edit Textbox) -->
                            <DataGridTemplateColumn Header="Số Lượng Nhập" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Sử dụng UpdateSourceTrigger=PropertyChanged để tính lại tiền ngay khi gõ -->
                                        <TextBox Text="{Binding SoLuong, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringToNumberConverter}}" 
                                                 Margin="4" VerticalContentAlignment="Center" Padding="4,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột Đơn Giá (Edit Textbox) -->
                            <DataGridTemplateColumn Header="Đơn Giá Nhập" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Sử dụng UpdateSourceTrigger=PropertyChanged để tính lại tiền ngay khi gõ -->
                                        <TextBox Text="{Binding DonGia, StringFormat=N0, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringToNumberConverter}}" 
                                                 Margin="4" VerticalContentAlignment="Center" Padding="4,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cột Thành Tiền (ReadOnly TextBlock) -->
                            <DataGridTemplateColumn Header="Thành Tiền" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ThanhTien, StringFormat=N0}" 
                                                   FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"
                                                   VerticalAlignment="Center" Margin="8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- FOOTER SECTION (Lưu Phiếu) -->
            <Border Grid.Row="4" Background="{StaticResource SurfaceBrush}" CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#000" BlurRadius="10" ShadowDepth="1" Opacity="0.05" Direction="270" />
                </Border.Effect>
                <Button Content="💾 Lưu Phiếu Nhập Kho" 
                        Command="{Binding LuuPhieuNhapCommand}"
                        Background="{StaticResource SuccessBrush}" 
                        Style="{StaticResource ActionButton}" 
                        Height="48" FontSize="16" HorizontalAlignment="Right" Padding="32,0" Margin="0" />
            </Border>
        </Grid>
    </Border>
</UserControl>
